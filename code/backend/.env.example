# Server porti (Render o'zi PORT beradi)
PORT=5000
# production | development
NODE_ENV=development

# --- Ma'lumotlar bazasi: 1-variant — Supabase yoki boshqa bulut PostgreSQL ---
# Supabase: Project Settings -> Database -> Connection string (URI).
# Render kabi IPv4 serverlar uchun "Session pooler" (port 5432) manzilini oling.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:PAROL@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# SSL: supabase manzilida avtomatik yoqiladi. Boshqa bulut bazada kerak bo'lsa: DB_SSL=true
# DB_SSL=true

# --- 2-variant — lokal PostgreSQL (DATABASE_URL bo'sh bo'lsa ishlatiladi) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qurilish_dokoni
DB_USER=postgres
DB_PASSWORD=postgres

# JWT tokenni imzolash kaliti. Production'da MAJBURIY, uzun tasodifiy qator yozing:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend manzili (CORS). Bir nechta bo'lsa vergul bilan:
#   CORS_ORIGIN=http://localhost:5173,https://qurilishdokoni.vercel.app
CORS_ORIGIN=http://localhost:5173

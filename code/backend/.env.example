# Server porti (Render o'zi PORT beradi)
PORT=5000
# production | development
NODE_ENV=development

# --- Ma'lumotlar bazasi: 1-variant — Supabase yoki boshqa bulut PostgreSQL (production'da MAJBURIY) ---
# Supabase: Connect -> Connection string -> "Session pooler" (port 5432) manzilini oling.
# DATABASE_URL=postgresql://postgres.xxxxxxxx:PAROL@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# SSL: supabase manzilida avtomatik yoqiladi. Boshqa bulut bazada kerak bo'lsa: DB_SSL=true
# DB_SSL=true

# --- 2-variant — lokal PostgreSQL (DATABASE_URL bo'sh bo'lsa ishlatiladi) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qurilish_dokoni
DB_USER=postgres
DB_PASSWORD=postgres

# --- Maxfiy kalitlar (MAJBURIY, har biri kamida 32 bayt, ikkalasi har xil) ---
# Yaratish:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Access token (JWT, HS256) imzosi:
JWT_ACCESS_SECRET=
# Captcha javobining HMAC kaliti:
CAPTCHA_SECRET=

# --- Boshlang'ich admin (npm run db:seed-admin yoki db:init) ---
# Username: 3–32 belgi, a-z 0-9 _ . (bo'sh bo'lsa: admin)
ADMIN_USERNAME=admin
# Vaqtinchalik parol: kamida 8 belgi, kamida 1 harf va 1 raqam, username'dan farqli.
# Bo'sh qoldirsangiz — tasodifiy parol yaratiladi va konsolga BIR MARTA chiqadi.
# Admin birinchi kirishda parolni o'zgartirishi shart. Ishlatib bo'lgach bu qatorni tozalang.
ADMIN_INITIAL_PASSWORD=

# Frontend manzili (CORS). Production'da MAJBURIY. Bir nechta bo'lsa vergul bilan (Vercel preview):
#   FRONTEND_URL=https://qurilishdokoni.vercel.app,https://qurilishdokoni-git-dev.vercel.app
FRONTEND_URL=http://localhost:5173

# Testlar (npm test) alohida lokal bazada ishlaydi. DATABASE_URL testda HECH QACHON ishlatilmaydi.
# TEST_DB_NAME=qurilish_dokoni_test

{
  "name": "qurilish-dokoni-backend",
  "version": "1.0.0",
  "description": "Qurilishdo'koni — internet-do'kon REST API (Node.js + Express + PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/db-init.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:seed-admin": "node scripts/seed-admin.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "svg-captcha": "^1.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
